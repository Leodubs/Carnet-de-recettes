---
import { getCollection } from 'astro:content';

const entries = (await getCollection('recipes')).sort((a, b) => a.data.ordre - b.data.ordre);
const RECETTES = entries.map((entry) => {
  const d = entry.data;
  const r: Record<string, unknown> = {
    id: d.id, cat: d.cat, name: d.name, time: d.time, parts: d.parts,
    origin: d.origin, desc: d.desc, ingredients: d.ingredients, steps: d.steps,
    tags: d.tags ?? [],
  };
  if (d.tip) r.tip = d.tip;
  return r;
});
const DATA = JSON.stringify(RECETTES).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carnet de recettes</title>
    <link rel="stylesheet" href="/style.css">
  </head>
<body>

  <header>
    <h1>Carnet de recettes<span class="dot">.</span></h1>
    <label class="search">
      <span aria-hidden="true">🔎</span>
      <input id="searchInput" type="text" placeholder="Mon envie du moment" />
    </label>
  </header>

  <div class="toolbar">
    <div class="tabs">
      <button class="tab active" data-cat="sale">🧂 Salé</button>
      <button class="tab" data-cat="sansgluten">🌾 Sans gluten</button>
      <button class="tab" data-cat="sucre">🍰 Sucré</button>
    </div>
    <div class="tagfilters" id="tagfilters">
      <button class="tagbtn" data-tag="viande">🥩 Viande</button>
      <button class="tagbtn" data-tag="poisson">🐟 Poisson</button>
      <button class="tagbtn" data-tag="végé">🌱 Végé</button>
      <button class="tagbtn" data-tag="vegan">🌿 Vegan</button>
    </div>
    <div class="count" id="count"></div>
  </div>

  <main>
    <div class="section-title">
      <h2 id="catTitle">Salé</h2>
      <span class="line"></span>
    </div>
    <div class="grid" id="grid"></div>
    <div class="empty" id="empty" style="display:none"></div>
  </main>

  <div class="overlay" id="overlay">
    <div class="modal" id="modal" role="dialog" aria-modal="true"></div>
  </div>

  <footer>
    <p>Prototype imaginé pour mes inspirations culinaires · Créé avec Mistral © <a href="https://eleonoredbs.com">Eleonore Dubois</a></p>
  </footer>

  <script type="application/json" id="recipes-data" set:html={DATA}></script>
  <script>
// 📌 BACK DU SITE — pour ajouter une recette : créer un fichier .md dans src/content/recipes/
// (voir ASTRO.md). Plus besoin d’éditer index.html ni les tableaux RECETTES/TAGS.
const RECETTES = JSON.parse(document.getElementById('recipes-data').textContent);
const CATS = {
  sale: { label: "Salé", chipLabel: "🧂 Partie salée" },
  sucre: { label: "Sucré", chipLabel: "🍰 Partie sucrée" },
  sansgluten: { label: "Sans gluten", chipLabel: "🌾 Sans gluten" }
};
const grid = document.getElementById("grid");
const catTitle = document.getElementById("catTitle");
const empty = document.getElementById("empty");
const searchInput = document.getElementById("searchInput");
const count = document.getElementById("count");
let activeCat = "sale";
let activeTag = null;

function tagsOf(r) { return r.tags || []; }
function tagsHTML(r) {
  return \`<div class="card-tags">\${tagsOf(r).map(t =>
    \`<span class="tag-pill pill-\${t === "végé" ? "vege" : t}">\${t}</span>\`).join("")}</div>\`;
}
function cardHTML(r) {
  return \`
    <article class="card" data-id="\${r.id}" tabindex="0" role="button" aria-label="Ouvrir la recette \${r.name}">
      <div class="card-body">
        \${tagsHTML(r)}
        <h3>\${r.name}</h3>
        <p class="desc">\${r.desc}</p>
        <div class="meta">
          <span class="chip">⏱ \${r.time}</span>
          <span class="chip">🍽 \${r.parts}</span>
        </div>
      </div>
    </article>\`;
}
function render() {
  const q = searchInput.value.trim().toLowerCase();
  const list = RECETTES.filter(r => {
    const okCat = r.cat === activeCat;
    const okTag = !activeTag || tagsOf(r).includes(activeTag);
    const text = (r.name + " " + r.desc + " " + r.origin + " " + r.ingredients.join(" ")).toLowerCase();
    return okCat && okTag && text.includes(q);
  });
  document.getElementById("tagfilters").style.display = activeCat === "sucre" ? "none" : "flex";
  catTitle.textContent = CATS[activeCat].label;
  grid.innerHTML = list.map(cardHTML).join("");
  count.textContent = list.length + (list.length > 1 ? " recettes" : " recette");
  if (!list.length) {
    empty.style.display = "block";
    empty.textContent = q
      ? "Aucune recette ne correspond à ta recherche 😕"
      : "Pas encore de recette ici — la section arrive bientôt 🌱";
  } else {
    empty.style.display = "none";
  }
}
document.querySelectorAll(".tab").forEach(tab => {
  tab.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
    tab.classList.add("active");
    activeCat = tab.dataset.cat;
    activeTag = null;
    document.querySelectorAll(".tagbtn").forEach(b => b.classList.remove("active"));
    render();
  });
});
document.querySelectorAll(".tagbtn").forEach(btn => {
  btn.addEventListener("click", () => {
    activeTag = activeTag === btn.dataset.tag ? null : btn.dataset.tag;
    document.querySelectorAll(".tagbtn").forEach(b =>
      b.classList.toggle("active", b.dataset.tag === activeTag));
    render();
  });
});
searchInput.addEventListener("input", render);
const overlay = document.getElementById("overlay");
const modal = document.getElementById("modal");
function openRecipe(id) {
  const r = RECETTES.find(x => x.id === id);
  if (!r) return;
  modal.innerHTML = \`
    <div class="modal-head \${r.cat}">
      <button class="close" aria-label="Fermer">✕</button>
      <h2>\${r.name}</h2>
      <div class="origin">\${r.origin}</div>
      <div class="modal-meta">
        <span class="chip">⏱ \${r.time}</span>
        <span class="chip">🍽 \${r.parts}</span>
        <span class="chip">\${CATS[r.cat].chipLabel}</span>
        \${tagsOf(r).map(t => \`<span class="tag-pill pill-\${t === "végé" ? "vege" : t}">\${t}</span>\`).join("")}
      </div>
    </div>
    <div class="modal-body">
      <div>
        <h3>Ingrédients</h3>
        <ul class="ingredients">
          \${r.ingredients.map(i => \`<li><span class="box">✓</span><span>\${i}</span></li>\`).join("")}
        </ul>
      </div>
      <div>
        <h3>Préparation</h3>
        <ol class="steps">
          \${r.steps.map(s => \`<li>\${s}</li>\`).join("")}
        </ol>
        \${r.tip ? \`<div class="tip"><strong>Le truc en plus :</strong> \${r.tip}</div>\` : ""}
      </div>
    </div>\`;
  overlay.classList.add("open");
  document.body.style.overflow = "hidden";
  modal.querySelector(".close").addEventListener("click", closeRecipe);
  modal.querySelectorAll("ul.ingredients li").forEach(li => {
    li.addEventListener("click", () => li.classList.toggle("done"));
  });
}
function closeRecipe() {
  overlay.classList.remove("open");
  document.body.style.overflow = "";
}
overlay.addEventListener("click", e => { if (e.target === overlay) closeRecipe(); });
document.addEventListener("keydown", e => { if (e.key === "Escape") closeRecipe(); });
grid.addEventListener("click", e => {
  const card = e.target.closest(".card");
  if (card) openRecipe(card.dataset.id);
});
grid.addEventListener("keydown", e => {
  if (e.key === "Enter" || e.key === " ") {
    const card = e.target.closest(".card");
    if (card) { e.preventDefault(); openRecipe(card.dataset.id); }
  }
});
render();
  </script>
  </body>
</html>
